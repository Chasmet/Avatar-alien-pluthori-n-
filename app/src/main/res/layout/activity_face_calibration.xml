<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#070715">
  <LinearLayout android:id="@+id/calContent"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:padding="8dp" android:orientation="vertical">
    <TextView android:id="@+id/calTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Calibration faciale 3D"
        android:textSize="21sp" android:textColor="#F3E4FF" android:textStyle="bold"
        android:padding="7dp"/>
    <TextView android:id="@+id/calInstructions" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appuie sur « GRAND ÉCRAN » pour calibrer les points avec zoom et réglage précis."
        android:textSize="13sp" android:textColor="#D3C6E8" android:padding="7dp"/>
    <FrameLayout android:id="@+id/calWorkspace" android:layout_width="match_parent"
        android:layout_height="335dp" android:background="#19182A">
      <FrameLayout android:id="@+id/calGlbFrame"
          android:layout_width="match_parent" android:layout_height="match_parent"/>
      <FrameLayout android:id="@+id/calCameraSlot"
          android:layout_width="116dp" android:layout_height="154dp"
          android:layout_gravity="top|right" android:layout_margin="8dp"
          android:background="#303044">
        <TextureView android:id="@+id/calCamera"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="5dp" android:text="CAMÉRA LIVE"
            android:textColor="#FFFFFF" android:textSize="10sp"
            android:background="#AA000000"/>
      </FrameLayout>
      <LinearLayout android:id="@+id/calWorkspaceToolbar"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_gravity="top|left" android:orientation="vertical"
          android:layout_margin="6dp">
        <Button android:id="@+id/calPrecision"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="0dp" android:text="GRAND ÉCRAN"
            android:textAllCaps="false" android:textColor="#FFFFFF"
            android:backgroundTint="#7142AA"/>
        <Button android:id="@+id/calFreezeMotion"
            android:layout_width="wrap_content" android:layout_height="43dp"
            android:minWidth="0dp" android:text="TÊTE GELÉE"
            android:textSize="11sp" android:textAllCaps="false"
            android:backgroundTint="#363153"
            android:visibility="gone"/>
        <TextView android:id="@+id/calZoomStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:padding="7dp" android:text="Zoom 100 %"
            android:textColor="#E6D8FF" android:textSize="12sp"
            android:background="#AA141329"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/calPrecisionTools"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_gravity="bottom"
          android:orientation="vertical" android:padding="5dp"
          android:background="#EB121126" android:visibility="gone">
        <TextView android:id="@+id/calPointInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:text="Choisis un repère puis glisse-le sur le GLB"
            android:textSize="13sp" android:textColor="#F0DFFE"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
          <Button android:id="@+id/calSelectLeft" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="ŒIL G" android:textSize="12sp" android:textAllCaps="false"/>
          <Button android:id="@+id/calSelectRight" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="ŒIL D" android:textSize="12sp" android:textAllCaps="false"/>
          <Button android:id="@+id/calSelectMouth" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="BOUCHE" android:textSize="12sp" android:textAllCaps="false"/>
          <Button android:id="@+id/calPrecisionDone" android:layout_width="0dp"
              android:layout_weight="1.25" android:layout_height="44dp" android:minWidth="0dp"
              android:text="TERMINÉ" android:textSize="12sp" android:textAllCaps="false"
              android:backgroundTint="#7151B5" android:textColor="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
          <Button android:id="@+id/calZoomMinus" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="−" android:textSize="19sp"/>
          <Button android:id="@+id/calZoomPlus" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="+" android:textSize="19sp"/>
          <Button android:id="@+id/calCenterView" android:layout_width="0dp"
              android:layout_weight="2" android:layout_height="44dp" android:minWidth="0dp"
              android:text="RECENTRER" android:textSize="12sp" android:textAllCaps="false"/>
          <TextView android:id="@+id/calFineStep" android:layout_width="0dp"
              android:layout_weight="1.5" android:layout_height="44dp"
              android:gravity="center" android:text="Pas 0,5 %"
              android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
          <Button android:id="@+id/calNudgeLeft" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="←" android:textSize="19sp"/>
          <Button android:id="@+id/calNudgeUp" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="↑" android:textSize="19sp"/>
          <Button android:id="@+id/calNudgeDown" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="↓" android:textSize="19sp"/>
          <Button android:id="@+id/calNudgeRight" android:layout_width="0dp"
              android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp"
              android:text="→" android:textSize="19sp"/>
          <Button android:id="@+id/calStepToggle" android:layout_width="0dp"
              android:layout_weight="1.3" android:layout_height="44dp" android:minWidth="0dp"
              android:text="0,1 % / 0,5 %" android:textSize="10sp" android:textAllCaps="false"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1 doigt : placer le repère · 2 doigts : zoomer ou déplacer le modèle"
            android:textColor="#C5B8D8" android:gravity="center" android:textSize="11sp"
            android:padding="3dp"/>
      </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/calOptions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
      <TextView android:id="@+id/calDiagnostics"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Initialisation de la caméra et du personnage 3D…"
          android:textColor="#9EE9F7" android:textSize="12sp" android:padding="10dp"
          android:background="#211A36"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Mode de calibration" android:layout_marginTop="12dp"
          android:textColor="#E4C8FA" android:textStyle="bold" android:textSize="16sp"/>
      <RadioGroup android:id="@+id/calMode" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical">
        <RadioButton android:id="@+id/calAuto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Auto : repères estimés"
            android:textColor="#FFFFFF" android:buttonTint="#C292FA"/>
        <RadioButton android:id="@+id/calManual" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Manuel : repères déplacés"
            android:textColor="#FFFFFF" android:buttonTint="#C292FA"/>
        <RadioButton android:id="@+id/calHybrid" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hybride : caméra + correction manuelle"
            android:textColor="#FFFFFF" android:buttonTint="#C292FA"/>
      </RadioGroup>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/calNeutral" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="Visage neutre" android:textAllCaps="false"/>
        <Button android:id="@+id/calMouthOpen" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="Bouche ouverte" android:textAllCaps="false"/>
        <Button android:id="@+id/calBlinkTest" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:text="Test yeux" android:textAllCaps="false"/>
      </LinearLayout>
      <TextView android:id="@+id/calCaptureNote"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Les tests enregistrent les valeurs réellement vues par la caméra."
          android:textColor="#BFB5D2" android:textSize="12sp" android:padding="5dp"/>
      <LinearLayout android:id="@+id/calSliders" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:orientation="vertical"
          android:paddingTop="8dp"/>
      <Switch android:id="@+id/calIndependent" android:layout_width="match_parent"
          android:layout_height="54dp" android:text="Cligner chaque œil séparément"
          android:textColor="#FFFFFF" android:checked="true"/>
      <Switch android:id="@+id/calReverse" android:layout_width="match_parent"
          android:layout_height="54dp" android:text="Inverser haut / bas de la tête"
          android:textColor="#FFFFFF"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="Lève puis baisse la tête. Le modèle doit regarder dans le même sens."
          android:paddingTop="8dp" android:paddingBottom="10dp"
          android:textColor="#D5C5E4" android:textSize="12sp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="horizontal">
        <Button android:id="@+id/calReset" android:layout_width="0dp"
            android:layout_height="55dp" android:layout_weight="1"
            android:text="Réinitialiser" android:textAllCaps="false"/>
        <Button android:id="@+id/calSave" android:layout_width="0dp"
            android:layout_height="55dp" android:layout_weight="2"
            android:text="Enregistrer pour ce GLB" android:textAllCaps="false"
            android:backgroundTint="#7546AB" android:textColor="#FFFFFF"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
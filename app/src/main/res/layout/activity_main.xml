<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#050513">
    <TextView android:id="@+id/header" android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center" android:text="CHK  Alien Live" android:textColor="#E6C6FF"
        android:textSize="24sp" android:textStyle="bold" />
    <FrameLayout android:id="@+id/stageFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <fr.chk.alienlive.AlienStageView android:id="@+id/alienStage"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/liveHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|start" android:layout_margin="14dp" android:padding="9dp"
            android:background="@drawable/panel" android:text="● PARTAGE D’ÉCRAN TIKTOK"
            android:textColor="#F6E9FF" android:textSize="12sp"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/controlPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="13dp" android:orientation="vertical" android:background="@drawable/panel">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Préparation caméra…" android:textColor="#D5C9E7" android:gravity="center" android:textSize="12sp" android:padding="4dp"/>
        <Button android:id="@+id/buttonLive" android:layout_width="match_parent" android:layout_height="50dp"
            android:text="MODE LIVE — PLEIN ÉCRAN" android:background="@drawable/btn_primary" android:textAllCaps="false" android:textColor="#FFFFFF" />
        <Button android:id="@+id/buttonVoice" android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Activer la voix extraterrestre — appui long : réglages" android:textAllCaps="false" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center" android:orientation="horizontal">
            <Button android:id="@+id/buttonAlien" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Personnages" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <Button android:id="@+id/buttonScene" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Décors" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <Button android:id="@+id/buttonVoiceMenu" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Voix" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <Button android:id="@+id/buttonSettings" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Réglages" android:textAllCaps="false" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

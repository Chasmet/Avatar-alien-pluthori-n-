<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#050513" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
            android:text="Nous sommes le peuple de Pluthor" android:textStyle="bold"
            android:textColor="#FFFFFF" android:textSize="25sp" android:gravity="center_vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Météo et décors animés"
            android:textStyle="bold" android:textColor="#E6B5FF" android:textSize="20sp" />
        <Switch android:id="@+id/animatedWeather" android:layout_width="match_parent"
            android:layout_height="60dp" android:text="Activer les décors vivants"
            android:textColor="#FFFFFF" android:checked="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sélectionner la météo" android:textColor="#DDCDE9" android:textSize="15sp" />
        <Spinner android:id="@+id/weatherMode" android:layout_width="match_parent"
            android:layout_height="58dp" android:backgroundTint="#B083F4" />
        <TextView android:id="@+id/weatherIntensityLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Intensité des effets : 65 %" android:textColor="#DDCDE9" android:textSize="15sp" />
        <SeekBar android:id="@+id/weatherIntensity" android:layout_width="match_parent"
            android:layout_height="50dp" android:max="100" android:progress="65" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="La météo évolutive change automatiquement toutes les 65 secondes, avec transitions progressives. Brume, poussière, nuages, pluie et orages sont générés sans connexion."
            android:textColor="#BCAFD1" android:textSize="13sp" android:paddingBottom="16dp" />
        <Switch android:id="@+id/batterySaver" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="Économie de batterie (20 images/s)" android:textColor="#FFFFFF" android:checked="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:text="Mises à jour (majauto)"
            android:textStyle="bold" android:textColor="#E6B5FF" android:textSize="20sp" />
        <Switch android:id="@+id/autoUpdate" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="Recherche automatique des nouvelles versions" android:textColor="#FFFFFF" android:checked="true" />
        <Button android:id="@+id/checkUpdate" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Vérifier les mises à jour" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Suivi facial temps réel"
            android:textStyle="bold" android:textColor="#E6B5FF" android:textSize="20sp" />
        <Switch android:id="@+id/useModel3D" android:layout_width="match_parent"
            android:layout_height="56dp" android:checked="true"
            android:text="Personnages GLB 3D : originaux et importés"
            android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Importe Annunaki 1 et tes futurs GLB dans Personnages. Ils restent sur le téléphone après les mises à jour signées. Le GLB Alpha historique et les portraits restent conservés."
            android:textColor="#C0B5D2" android:textSize="12sp"/>
        <Switch android:id="@+id/experimental3D" android:layout_width="match_parent"
            android:layout_height="56dp" android:checked="false"
            android:text="Tester les GLB reconstruits des autres aliens"
            android:textColor="#FFFFFF"/>
        <Switch android:id="@+id/experimentalAlpha" android:layout_width="match_parent"
            android:layout_height="56dp" android:checked="false"
            android:text="Tester le GLB Alpha reconstruit (non recommandé)"
            android:textColor="#FFFFFF"/>
        <Switch android:id="@+id/naturalModel" android:layout_width="match_parent"
            android:layout_height="58dp" android:checked="true"
            android:text="Masquer les volumes gris (GLB expérimentaux)"
            android:textColor="#FFFFFF"/>
        <Switch android:id="@+id/followHead" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Suivre les mouvements de tête" android:textColor="#FFFFFF" android:checked="true"/>
        <Switch android:id="@+id/animateEyes" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Clignements et expressions des yeux" android:textColor="#FFFFFF" android:checked="true"/>
        <Switch android:id="@+id/animateMouth" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Animation des lèvres et de la mâchoire"
            android:textColor="#FFFFFF" android:checked="true"/>
        <TextView android:id="@+id/mouthSensitivityLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Sensibilité de la bouche : 75 %"
            android:textColor="#E8D8FF" android:layout_marginTop="12dp"/>
        <SeekBar android:id="@+id/mouthSensitivity" android:layout_width="match_parent"
            android:layout_height="48dp" android:max="100" android:progress="75"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Avant le LIVE, parle devant la caméra. L'écran d'accueil affiche le niveau d'ouverture détecté. Pour une bouche plus expressive, augmente la sensibilité."
            android:textColor="#BCAFD1" android:textSize="13sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="La transformation vocale sort par les haut-parleurs du téléphone et ne remplace pas automatiquement le micro d’une autre application. Le visage est suivi par la caméra et le maillage du portrait reproduit la mâchoire, la bouche et les paupières. Le suivi des phonèmes précis reste impossible avec une simple photo 2D ; un personnage 3D riggé sera nécessaire."
            android:textColor="#C8BDD8" android:textSize="14sp" />
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="70dp"
            android:gravity="center_vertical" android:textColor="#B89ACF" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
